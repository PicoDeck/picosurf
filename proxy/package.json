{
  "name": "picosurf-proxy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "tsx src/serve.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "fixtures:pages": "sh scripts/fetch-fixtures.sh",
    "fixtures:images": "tsx scripts/make-image-fixtures.ts"
  },
  "dependencies": {
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@mozilla/readability": "0.6.0",
    "fast-xml-parser": "5.11.2",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.13",
    "omggif": "1.0.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/omggif": "1.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  }
}
